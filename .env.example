# ==============================================================================
# 🌟 PROJECT "AETHER-HUMAN" — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit your real .env to GitHub or share it publicly!)
# 2. Fill in your credentials, API keys, and Telegram IDs below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 👑 1. SOVEREIGN GOVERNANCE & ADMIN HIERARCHY (إعدادات السيادة والإدارة العليا)
# ------------------------------------------------------------------------------
# Your personal Telegram User ID (The Sovereign King & System Creator)
# اكتب هنا معرف التيليجرام الخاص بك (المالك والملك وصاحب السيادة المطلقة):
KING_ID=1234567890

# Comma-separated list of Super Admin Telegram User IDs
# قائمة معرفات التيليجرام للأدمنز والمسؤولين (مفصولة بفواصل):
ADMIN_USER_IDS=1234567890,9876543210

# Public Developer / Co-Admin Telegram ID (Optional - e.g. Marcel)
# معرف المطور الواجهة أمام المستخدمين (اختياري):
MARCEL_ID=9876543210

# Authorized Family / Operator Telegram ID (Optional - e.g. Uncle)
# معرف العم أو المشغل الإداري الإضافي (اختياري):
UNCLE_ID=0

# Admin Telemetry Supergroup ID with Topics enabled (Optional)
# أيدي السوبر جروب الخاص بغرفة المراقبة والعمليات:
ADMIN_TELEMETRY_SUPERGROUP_ID=

# ------------------------------------------------------------------------------
# 🤖 2. TELEGRAM API CREDENTIALS (بيانات اعتماد تيليجرام - Userbot & Bot API)
# ------------------------------------------------------------------------------
# Get your API ID and Hash from: https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Primary Official Bot Token (from @BotFather)
# توكن البوت الرسمي الأساسي من BotFather:
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenHere_abcdef1234567890

# Phone number for MTProto Userbot login (international format: +201xxxxxxxxx)
# رقم هاتف حساب اليوزربوت البشري:
TELEGRAM_PHONE_NUMBER=+201000000000
TELEGRAM_SESSION_NAME=aether_userbot
TELEGRAM_SESSION_STRING=

# ------------------------------------------------------------------------------
# 🧠 3. GOOGLE GEMINI MULTI-KEY ROTATION POOL (مجمع مفاتيح جيميني الدوار)
# ------------------------------------------------------------------------------
# Comma-separated list of Gemini API Keys (Get free keys from: https://aistudio.google.com)
# أدخل مفاتيح جيميني مفصولة بفواصل لدعم التدوير الذاتي ومقاومة حظر الـ Quota:
GEMINI_API_KEYS=AIzaSyExampleKey1,AIzaSyExampleKey2,AIzaSyExampleKey3

# Models Configuration
GEMINI_DEFAULT_MODEL=gemini-flash-lite-latest
GEMINI_REASONING_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.85
GEMINI_MAX_OUTPUT_TOKENS=1024

# ------------------------------------------------------------------------------
# 🗄️ 4. DATABASE & PERSISTENCE (قواعد البيانات والذاكرة المدمجة)
# ------------------------------------------------------------------------------
# Relational DB: SQLite (default out-of-the-box) or PostgreSQL: postgresql+asyncpg://user:pass@host:5432/db
POSTGRES_URL=sqlite+aiosqlite:///./aether_human.db

# Neo4j Social Graph (Optional - falls back gracefully if not running)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aether_secret_pass

# Qdrant Vector Engine (Optional - falls back to in-memory/heuristic vector store)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 🎙️ 5. MULTIMODAL & VOICE SYNTHESIS (محرك الصوت والوسائط المتعددة)
# ------------------------------------------------------------------------------
# ElevenLabs API Key (Optional - Edge-TTS with smartphone acoustic DSP is used by default for zero cost)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Whisper Model size for Incoming Voice Notes (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base

# ComfyUI Host & Port for Visual DNA Face-Locking (Optional)
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# ------------------------------------------------------------------------------
# 🌐 6. MINI-APP WEBAPP & ADMIN OBSERVATORY (لوحة التحكم وتطبيق الويب)
# ------------------------------------------------------------------------------
APP_NAME=AetherHumanCore
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false
ENABLE_SLEEP_GHOSTING=false

# Admin Dashboard Server
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000
ADMIN_SECRET_TOKEN=aether_observatory_master_key_2026

# Optional Cloudflare Tunnel Public WebApp URL override
WEBAPP_PUBLIC_URL=
